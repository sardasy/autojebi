# === 공공 API ===
DATA_GO_KR_API_KEY=your_api_key_here
KEPCO_API_KEY=your_kepco_key_here

# === LLM ===
ANTHROPIC_API_KEY=your_claude_key_here
OPENAI_API_KEY=your_openai_key_here

# === Database ===
DATABASE_URL=postgresql+psycopg://bidding:bidding_pass@localhost:5433/bidding_db
REDIS_URL=redis://localhost:6379/0

# === Vector DB ===
CHROMA_PERSIST_DIR=./data/chroma

# === OCR ===
CLOVA_OCR_SECRET=your_clova_secret
CLOVA_OCR_URL=your_invoke_url

# === Notification ===
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR_WEBHOOK_URL
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=bidding-bot@company.com
SMTP_PASSWORD=your_smtp_password
NOTIFICATION_RECIPIENTS=team@company.com

# === App Config ===
RELEVANCE_THRESHOLD=0.6
MAX_DAILY_NOTIFICATIONS=10
COLLECT_SCHEDULE_HOUR=8
COLLECT_SCHEDULE_MINUTE=0
LOG_LEVEL=INFO
