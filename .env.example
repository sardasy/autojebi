# Copy to .env and fill in real values (DO NOT COMMIT .env)

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bid

# (Optional) Teams webhook (stub by default)
TEAMS_WEBHOOK_URL=

# Claude / RAG (M2: Claude 실가동, M3 Qdrant)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=2048
# Current /workspace analysis and grounded proposals only. Legacy APIs remain Claude.
WORKSPACE_LLM_PROVIDER=anthropic
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=16384
# OpenAI for /workspace only. Select WORKSPACE_LLM_PROVIDER=openai to enable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=16384
LLM_ATTACHMENT_FETCH=true
G2B_ATTACHMENT_DIR=

# Qdrant (M3) — docker compose -f infra/docker-compose.yml up -d qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=abb_skus

# M3 그레이딩 가중치 (합 1.0)
GRADE_WEIGHT_SPEC=0.5
GRADE_WEIGHT_QUAL=0.2
GRADE_WEIGHT_PRICE=0.3
GRADE_HARD_GATE_QUAL_ZERO=true
GRADE_ALERT_THRESHOLD=0.6

# Slack incoming webhook (M3 grade 알림). 빈값이면 발송 안함.
SLACK_WEBHOOK_URL=

# ABB 등록지역 (M5 자격 API region rule에 사용)
ABB_REGISTERED_REGIONS=서울,경기,전국

# M5 자동 grade 스케줄러
SCHEDULER_GRADE_ENABLED=true
GRADE_INTERVAL_MINUTES=30      # 0이면 미등록
GRADE_BATCH_LIMIT=50           # 한 번 실행 시 최대 grade 공고 수 (안전장치)

# M6 자격 API in-memory 캐시
QUAL_CACHE_ENABLED=true
QUAL_CACHE_TTL_HOURS=24        # 같은 (bid_no, bid_seq) 24h 이내 재grade 시 G2B API 호출 안함

# M7 Next.js 프론트
FRONTEND_ORIGIN=http://localhost:3000        # CORS 허용 origin (CSV로 여러 개 가능)
NEXT_PUBLIC_API_BASE=http://localhost:8001   # 프론트가 호출할 API URL (build/run time inline)

# 배포 환경: development | staging | production. production 은 API_KEY 공란이면 기동 실패.
APP_ENV=development

# M9 API 키 인증 (빈값이면 비활성 — 개발 환경 친화)
API_KEY=                                     # 운영: 32+ 문자 랜덤 시크릿. 빈값이면 인증 OFF.
INTERNAL_API_KEY=                            # Server Action server-side 주입용 (보통 API_KEY와 동일값)

# 나라장터 OpenAPI (data.go.kr 공공데이터포털) — M1
DATA_GO_KR_API_KEY=
# https (default) or http. HTTP sends the service key without transport encryption.
# Use http only when explicitly following the provider's HTTP service contract.
G2B_API_SCHEME=https

# G2B 일일 수집 스케줄 (KST 기준). SCHEDULER_ENABLED=false 로 끌 수 있음.
COLLECT_HOUR=8
COLLECT_MINUTE=0
SCHEDULER_ENABLED=true

# G2B 검색 키워드 (쉼표 구분)
BID_KEYWORDS=ABB,차단기,변압기,인버터,전력변환,UPS,배전반,IGBT,모터드라이브

# 로그 레벨
LOG_LEVEL=INFO

# In-repo Windows Worker: pip install -e ".[hwp-worker]"; python -m api.hwp_worker
# API and Worker require the same HWP_AGENT_TOKEN (32+ random characters).
# No empty-token bypass. v2 uses local Windows API and shared filesystem paths.
# Loopback only; do not expose COM over 0.0.0.0 for Docker access.
HWP_AGENT_BASE_URL=http://127.0.0.1:8000
HWP_AGENT_TOKEN=

# Company defaults used to fill bid-form placeholders. Override per-call
# via the autofill-form request body if a notice needs different values.
COMPANY_NAME=
COMPANY_BUSINESS_NUMBER=
COMPANY_CEO_NAME=
COMPANY_ADDRESS=

# M11 서류 자동화 v2 — 업로드/내보내기 저장소 (로컬 파일시스템)
# 빈값 → 시스템 temp 하위 autojebi/uploads, autojebi/exports 자동 생성.
# 도커: infra/docker-compose.yml에서 호스트 ./data/uploads, ./data/exports 마운트.
UPLOAD_DIR=
EXPORT_DIR=
UPLOAD_MAX_BYTES=30000000                                   # 30MB
UPLOAD_ALLOWED_EXTS=pdf,hwp,hwpx,jpg,jpeg,png,xls,xlsx,docx,zip # CSV, 점 없이; XLS/ZIP 원본 보존용, 자동 실행/압축 해제 없음
E2E_CLEANUP_ENABLED=false                                   # E2E-* 공고 cleanup API 활성화(dev/test 전용)

# Opt-in v2 workspace; no changes to existing runtime until verified.
WORKSPACE_V2_ENABLED=false
# Optional personal identity for all /v2 reads and writes; shared API key alone is insufficient.
# Configure exactly one registry source below before enabling. Never put raw personal tokens here.
# Records: id, name, role(viewer|writer|reviewer|approver), token_sha256, optional enabled.
# Registry files contain personal identifiers: keep outside version control with restricted access.
# Existing legacy APIs keep their shared-key policy. See docs/workspace-identity-2026-09-13.md.
WORKSPACE_AUTH_ENABLED=false
WORKSPACE_AUTH_USERS=
WORKSPACE_AUTH_REGISTRY=
WORKSPACE_DATA_DIR=data/workspace
HWP_TEMPLATE_ROOT=data
HWP_SOURCE_ROOT=data/workspace/uploads
HWP_OUTPUT_ROOT=data/workspace/exports
PROPOSAL_MODEL=

# Local OCR after an explicit workspace extraction request. No remote document upload.
# Install Tesseract and kor/eng language packs on the extraction host separately.
WORKSPACE_OCR_ENABLED=true
WORKSPACE_OCR_LANGUAGES=kor+eng
TESSERACT_CMD=
# Specification search is opt-in on the validation environment only.
SPEC_SEARCH_ENABLED=false
SPEC_SEARCH_ENV=validation
SPEC_NEO4J_URI=bolt://127.0.0.1:17687
SPEC_NEO4J_USER=neo4j
SPEC_NEO4J_PASSWORD=
SPEC_POSTGRES_PASSWORD=
SPEC_QDRANT_URL=http://127.0.0.1:16333
SPEC_QDRANT_API_KEY=
# Immutable HF commit SHA and already downloaded snapshots/<SHA> directory.
SPEC_BGE_REVISION=
SPEC_BGE_SNAPSHOT=

# Optional Day 1 decision layer. The TypeSafe SDK also accepts TYPESAFE_BASE_URL.
# The module is opt-in and is not connected to the collector or workspace automatically.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
WORKSPACE_JEV_ENABLED=false
WORKSPACE_JEV_POLICY_PATH=config/company.yaml
